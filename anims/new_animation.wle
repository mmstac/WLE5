# ==========================================================
# WLE5 MASTER ANIMATION SCRIPT
# ==========================================================

[Config]
IdleTimeout = 5.0
#
# ==== oooh ==========================================================
# IDLE STATES
# ==========================================================

[State: Idle]
Interval = 3.0 - 8.0
Play: idle_look_around   w:40   v:15   c:5
Play: idle_focus         w:30   v:10   c:5
Play: idle_blink         w:20   v:0    c:2
Play: idle_dadadat       w:10   v:0    c:120

[State: Thinking]
Interval = 3.0 - 6.0
Play: think_shift        w:50   v:10   c:5
Play: think_twitch       w:50   v:20   c:5

[State: Happy]
Interval = 2.0 - 5.0
Play: happy_dance        w:50   v:10   c:10
Play: happy_glyph        w:50   v:10   c:15

[State: Sleepy]
Interval = 5.0 - 10.0
Play: sleepy_nod         w:100  v:20   c:5


# ==========================================================
# EXPLICIT ANIMATIONS
# ==========================================================

[Anim: Init]
@0.0s  yaw=0  neck_base_pitch=-65  neck_top_pitch=80  head_pitch=-10  
@0.0s  left_eye=-15  right_eye=15  left_arm_rot=-45  right_arm_rot=-45
@0.0s  v_eyelid=101,30  v_aperture=101,3  v_glow_color=127 v_glow_pulse=70 v_gaze_x=50 v_gaze_y=50
@0.0s  v_img_select=0,255  v_img_opacity=0,255  v_asymmetry=0,255


[Anim: Rogue]
# Throws arms up, straightens neck, fades in Rogue graphic, and blinks in disbelief.
@0.0s  v_img_select=7,255  v_img_opacity=80,10  v_audio_play=9,30
@0.1s  left_arm_rot=90,200  right_arm_rot=90,200  neck_base_pitch=-30,200  neck_top_pitch=20,200  head_pitch=0,200
# Rapid double blink (Instant Snap)
@0.5s  v_eyelid=100,255
@0.65s v_eyelid=0,255
@1.0s  v_eyelid=100,255
@1.15s v_eyelid=0,255
@3.5s  left_arm_rot=-45,150  right_arm_rot=-45,150  neck_base_pitch=-65,100  neck_top_pitch=80,100  head_pitch=-10,100  v_img_opacity=0,10


[Anim: Lighter]
# Transfixed by flickering flame. Reaches out, gets startled, and pulls back sad.
@0.0s  v_idle_state=0 v_audio_play=11,30  head_pitch=10,50  v_img_select=2,255  v_img_opacity=60,4 v_eyelid=10 v_aperture=90
# Flicker loop
@0.1s  v_img_select=2,255
@0.6s  v_img_select=3,255
@1.1s  v_img_select=4,255
@1.6s  v_img_select=5,255
@2.1s  v_img_select=2,255
# Slowly reach out right arm and lean neck forward
@2.5s  right_arm_rot=45,30  neck_base_pitch=-45,30  neck_top_pitch=50,30  head_pitch=20,30
@3.1s  v_img_select=3,255
@3.6s  v_img_select=4,255
@4.1s  v_img_select=5,255
# Snap back quickly, fade out image, and play 'ohh'
@15.0s  right_arm_rot=-45,200  neck_base_pitch=-65,200  neck_top_pitch=80,200  head_pitch=-10,200  v_img_opacity=0,5  v_audio_play=6,60
@15.5s  left_eye=-30,60  right_eye=30,60  v_eyelid=40,20


[Anim: Repaired]
# Mechanically recalibrates eyes one by one, then synchronously.
@0.0s  v_audio_play=10,60  left_arm_rot=75,150  right_arm_rot=75,150
@1.0s  left_eye=30,120
@1.5s  left_eye=-30,120
@2.0s  left_eye=0,150
@2.5s  right_eye=-30,120
@3.0s  right_eye=30,120
@3.5s  right_eye=0,150
@4.0s  left_eye=30,150   right_eye=-30,150
@4.5s  left_eye=-30,150  right_eye=30,150
@5.0s  left_eye=30,150   right_eye=-30,150
@5.5s  left_eye=-30,150  right_eye=30,150
@6.0s  left_eye=0,200  right_eye=0,200
@7.0s  left_eye=-15,100  right_eye=15,100  left_arm_rot=-45,100  right_arm_rot=-45,100


[Anim: Plant]
# Leans in to inspect the plant, constricts aperture to focus.
@0.0s  v_img_select=6,255  v_img_opacity=80,4  v_audio_play=2,60
@0.1s  head_pitch=30,60  neck_base_pitch=-40,60  neck_top_pitch=30,60  left_arm_rot=-10,80  right_arm_rot=-10,80  v_aperture=60,10
@3.0s  head_pitch=-10,80  neck_base_pitch=-65,80  neck_top_pitch=80,80  left_arm_rot=-45,100  right_arm_rot=-45,100  v_img_opacity=0,4  v_aperture=0,10


[Anim: Stars]
# Plays "Out There", slowly fades in Galaxy, stares in bewilderment, raises right arm.
@0.0s  v_audio_play=7,40  left_arm_rot=-45,100 v_eyelid=40,80 v_aperture=40,80 right_arm_rot=-45,100  v_img_select=1,255
# Extremely slow, dramatic head lift and crossfade (Speed 2)
@0.1s  v_img_opacity=40,1  head_pitch=40,5
@0.6s v_eyelid=101,30 v_aperture=101,6
@2.0s  neck_base_pitch=-35,5  neck_top_pitch=40,5
# Reach for the stars with slight head tilt to the right
@2.2s v_img_opacity=100,1
@6.0s  right_arm_rot=60,10  yaw=15,10  left_eye=15,10  right_eye=15,10
@8s v_img_opacity=50,1
# Track is 28 seconds long. Begin returning to rest near the end.
@22.0s right_arm_rot=-45,40  neck_base_pitch=-65,40  neck_top_pitch=80,40  head_pitch=-10,40  yaw=0,40
@23.0s v_img_opacity=0,1  left_eye=-15,40  right_eye=15,40  v_aperture=101,3  v_eyelid=101,30 

[Anim: Curious]
# Classic head tilt with slight arm raise. 
@0.0s  neck_base_pitch=-50,100  neck_top_pitch=60,100  head_pitch=20,100
@0.2s  left_eye=20,100  right_eye=20,100  left_arm_rot=-20,100  v_aperture=30,20
@2.0s  left_eye=-15,100  right_eye=15,100  neck_base_pitch=-65,100  neck_top_pitch=80,100  head_pitch=-10,100  left_arm_rot=-45,100  v_aperture=0,20


[Anim: Scanning]
# Sweeps the environment. Eyelids narrow slightly in concentration.
@0.0s  v_eyelid=30,10  v_aperture=40,10
@0.1s  yaw=45,60
@1.5s  yaw=-45,60
@3.0s  yaw=0,60  v_eyelid=0,10  v_aperture=0,10


[Anim: Sad]
# Drops head entirely, severely droops eyes, dims the pulse.
@0.0s  neck_base_pitch=-80,50  neck_top_pitch=-10,50  head_pitch=-15,50
@0.2s  left_eye=-40,50  right_eye=40,50  v_eyelid=60,20  v_glow_pulse=20,10
@3.0s  left_eye=-15,80  right_eye=15,80  v_eyelid=0,20  v_glow_pulse=70,10  neck_base_pitch=-65,80  neck_top_pitch=80,80  head_pitch=-10,80


# ==========================================================
# IDLE SUB-ANIMATION HELPERS
# ==========================================================

[Anim: idle_look_around]
@0.0s  yaw=20,50  head_pitch=0,50
@1.5s  yaw=-20,40  head_pitch=-10,40
@3.0s  yaw=0,50

[Anim: idle_focus]
@0.0s  v_aperture=40,20
@0.5s  v_aperture=10,20
@1.2s  v_aperture=0,20

[Anim: idle_blink]
@0.0s  v_eyelid=90,50
@0.45s v_eyelid=0,30

[Anim: idle_dadadat]
@0.0s  v_audio_play=1,60  head_pitch=10,80
@1.0s  head_pitch=-10,80

[Anim: think_shift]
@0.0s  v_glow_color=220,100  v_glow_pulse=100,20  v_eyelid=50,20
@0.5s  yaw=15,80  head_pitch=-5,80
@2.0s  v_glow_color=150,100  v_glow_pulse=70,20  v_eyelid=0,20  yaw=0,80

[Anim: think_twitch]
@0.0s  right_arm_rot=-30,200
@0.2s  right_arm_rot=-45,200

[Anim: happy_dance]
@0.0s  v_audio_play=3,60  neck_base_pitch=-40,150  neck_top_pitch=100,150  head_pitch=20,150
@0.2s  left_arm_rot=-20,200  right_arm_rot=-20,200
@1.5s  left_arm_rot=-45,100  right_arm_rot=-45,100  neck_base_pitch=-65,100  neck_top_pitch=80,100  head_pitch=-10,100

[Anim: happy_glyph]
@0.0s  v_img_select=101,255  v_img_opacity=90,10
@1.5s  v_img_opacity=0,10

[Anim: sleepy_nod]
@0.0s  v_eyelid=80,5  v_glow_pulse=20,5  head_pitch=-15,20  neck_top_pitch=20,20
@2.0s  v_eyelid=100,255
@2.1s  v_eyelid=0,255  head_pitch=-10,80  neck_top_pitch=80,80  v_glow_pulse=70,10






